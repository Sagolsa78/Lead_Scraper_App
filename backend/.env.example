PORT=5005
NODE_ENV=development

# Google Maps Platform Keys
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key

# Google Sheets API Credentials
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# PostgreSQL & Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/leadfinder?schema=public"

# Redis & BullMQ
REDIS_URL="redis://localhost:6379"

# Authentication (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=generate_a_64_char_random_string_for_jwt_access_tokens_here_abc
JWT_REFRESH_SECRET=generate_a_64_char_random_string_for_jwt_refresh_tokens_xyz

# Encryption (min 16 characters, used for encrypting stored API tokens)
ENCRYPTION_KEY=generate_a_strong_encryption_key_here

# CORS (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173

# WhatsApp Cloud API (optional)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Twilio Phone Lookup (optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# AI Services (optional)
GEMINI_API_KEY=your_gemini_api_key

# Social Discovery (optional)
SERPAPI_KEY=your_serpapi_key
