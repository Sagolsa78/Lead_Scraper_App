generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id              String       @id @default(uuid())
  name            String
  address         String?
  phone           String       @unique
  rating          Float?
  website         String?
  googleMapsUrl   String?
  businessType    String?
  subCategory     String       @default("General")
  city            String?
  searchKeyword   String?
  placeId         String?      @unique
  whatsapp_sent   Boolean      @default(false)
  
  // New fields for Warm Lead Qualification
  phoneValid      Boolean      @default(false)
  whatsappEnabled Boolean      @default(false)
  status          String       @default("new") // new | validated | contacted | replied | report_pending | converted
  lastContactedAt DateTime?
  replyReceived   Boolean      @default(false)
  introMessageId  String?
  fullReportSent  Boolean      @default(false)
  
  // Link to Enriched Business Data
  businessId      String?
  business        Business?    @relation(fields: [businessId], references: [id])

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  messageLogs     MessageLog[]

  @@index([phone])
  @@index([city, businessType])
}

model MessageLog {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  status    String   // 'sent' or 'failed'
  response  Json?
  createdAt DateTime @default(now())

  @@index([leadId])
}

model Settings {
  id              Int      @id @default(1)
  whatsappToken   String?  // Will be encrypted
  whatsappMode    String   @default("manual") // 'cloud' or 'manual'
  updatedAt       DateTime @updatedAt
}

model PhoneLookup {
  id          String   @id @default(uuid())
  phone       String   @unique // E.164 format
  valid       Boolean
  lineType    String?  // 'mobile', 'landline', 'voip', etc.
  carrier     String?
  countryCode String?
  verifiedAt  DateTime @default(now())

  @@index([phone])
}

// --- Enterprise Architecture v2.0 Models ---

model RawData {
  id        String   @id @default(uuid())
  source    String   // "google_places", "website_scrape", "social_media", "whatsapp"
  dataType  String   // "business_list", "business_details", "reviews", "chat_log"
  data      Json     // Immutable raw data
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Business {
  id              String       @id @default(uuid())
  googlePlaceId   String?      @unique
  name            String
  address         String?
  phone           String?
  website         String?
  domain          String?      // Extracted from website for uniqueness
  
  // Enrichment Data
  rating          Float?
  reviewCount     Int?
  priceLevel      Int?
  
  // Categorization
  types           String[]
  primaryCategory String?
  
  // Relations
  leads           Lead[]
  reviews         Review[]
  competitors     Competitor[]
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Review {
  id             String    @id @default(uuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id])
  
  authorName     String?
  rating         Int
  text           String?
  publishTime    DateTime?
  originalId     String?   // ID from the source (e.g., Google Review ID)
  
  // Analysis
  sentimentScore Float?
  sentimentLabel String?   // "POSITIVE", "NEGATIVE", "NEUTRAL"
  topics         String[]  // ["Service", "Price", "Quality"]
  
  createdAt      DateTime  @default(now())
}

model Competitor {
  id              String   @id @default(uuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id])
  
  name            String
  placeId         String?
  similarityScore Float? 
  
  createdAt       DateTime @default(now())
}

model Report {
  id          String   @id @default(uuid())
  targetId    String   // ID of the Lead or Business this report is for
  type        String   // "SCOUT_REPORT", "STRATEGY_PLAN", "GAP_ANALYSIS"
  content     Json     // The structured output from the LLM
  
  createdAt   DateTime @default(now())
}
