generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ─── Auth & Tenant Models ────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER  
}

model Organization {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     User[]
  leads     Lead[]
  settings  Settings[]
  jobs      Job[]
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  name           String
  role           UserRole       @default(MEMBER)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  refreshTokens  RefreshToken[]

  @@index([organizationId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Core Business Models ────────────────────────────────────────────

model Lead {
  id              String       @id @default(uuid())
  name            String
  address         String?
  phone           String       @unique
  rating          Float?
  website         String?
  googleMapsUrl   String?
  businessType    String?
  subCategory     String       @default("General")
  city            String?
  searchKeyword   String?
  placeId         String?      @unique
  whatsapp_sent   Boolean      @default(false)

  // Social Discovery Fields
  instagramProfile String?
  facebookProfile  String?
  linkedinProfile  String?
  socialStatus     String       @default("NONE") // NONE | WEAK | ACTIVE | STRONG
  socialScore      Int          @default(0)
  socialData       Json?
  lastSocialCheck  DateTime?

  // Priority Scoring
  reviewScore      Int          @default(0)
  urgencyScore     Int          @default(0)
  categoryScore    Int          @default(0)
  finalScore       Float        @default(0)
  priority         String       @default("LOW") // HIGH | MEDIUM | LOW

  // Warm Lead Qualification
  phoneValid      Boolean      @default(false)
  whatsappEnabled Boolean      @default(false)
  status          String       @default("new") // new | validated | contacted | replied | report_pending | converted
  lastContactedAt DateTime?
  replyReceived   Boolean      @default(false)
  introMessageId  String?
  fullReportSent  Boolean      @default(false)

  // Relations
  businessId      String?
  business        Business?    @relation(fields: [businessId], references: [id])
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  messageLogs     MessageLog[]

  @@index([phone])
  @@index([city, businessType])
  @@index([organizationId])
}

model MessageLog {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  status    String   // 'sent' or 'failed'
  response  Json?
  createdAt DateTime @default(now())

  @@index([leadId])
}

model Settings {
  id              Int           @id @default(autoincrement())
  whatsappToken   String?       // Encrypted with AES-256-GCM
  whatsappMode    String        @default("manual") // 'cloud' or 'manual'
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  updatedAt       DateTime      @updatedAt

  @@index([organizationId])
}

model PhoneLookup {
  id          String   @id @default(uuid())
  phone       String   @unique // E.164 format
  valid       Boolean
  lineType    String?
  carrier     String?
  countryCode String?
  verifiedAt  DateTime @default(now())

  @@index([phone])
}

// ─── Enrichment Models ───────────────────────────────────────────────

model RawData {
  id        String   @id @default(uuid())
  source    String   // "google_places", "website_scrape", "social_media", "whatsapp"
  dataType  String   // "business_list", "business_details", "reviews", "chat_log"
  data      Json     // Immutable raw data
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Business {
  id              String       @id @default(uuid())
  googlePlaceId   String?      @unique
  name            String
  address         String?
  phone           String?
  website         String?
  domain          String?
  rating          Float?
  reviewCount     Int?
  priceLevel      Int?
  types           String[]
  primaryCategory String?

  leads           Lead[]
  reviews         Review[]
  competitors     Competitor[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Review {
  id             String    @id @default(uuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id])
  authorName     String?
  rating         Int
  text           String?
  publishTime    DateTime?
  originalId     String?
  sentimentScore Float?
  sentimentLabel String?
  topics         String[]
  createdAt      DateTime  @default(now())
}

model Competitor {
  id              String   @id @default(uuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id])
  name            String
  placeId         String?
  similarityScore Float?
  createdAt       DateTime @default(now())
}

model Report {
  id          String   @id @default(uuid())
  targetId    String   // ID of the Lead or Business this report is for
  type        String   // "SCOUT_REPORT", "STRATEGY_PLAN", "GAP_ANALYSIS"
  content     Json     // The structured output from the LLM
  
  createdAt   DateTime @default(now())
}

// ─── Job Models ─────────────────────────────────────────────────────

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum JobType {
  DISCOVERY
  ENRICHMENT
  BULK_WHATSAPP
}

model Job {
  id             String        @id @default(uuid())
  type           JobType
  status         JobStatus     @default(PENDING)
  progress       Int           @default(0)
  data           Json?         // Input parameters
  result         Json?         // Output summary
  error          String?       // Error message if failed
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?

  @@index([organizationId])
  @@index([status])
}
